# Copy to backend/.env and edit. Production on Cloud Run is configured by
# deploy/cloudrun/deploy.sh instead (secrets come from Secret Manager).

# development | production (production: HTTPS-only cookies, HSTS, strict startup checks)
ENV=development

# Dev uses a local SQLite file. Production needs Postgres:
#   postgresql+asyncpg://USER:PASS@/DB?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=sqlite+aiosqlite:///./data/breatheasy.db

# Google sign-in. Empty = accounts off (planning still works).
GOOGLE_OAUTH_CLIENT_ID=
# Signs session cookies. Required (32+ chars) in production: openssl rand -hex 32
SESSION_SECRET=

# open   = real data, no key, no billing (OpenStreetMap routing + Open-Meteo air quality). Default.
# google = Google Routes + Air Quality (~500 m grid). Needs GOOGLE_MAPS_SERVER_KEY and billing.
# mock   = synthetic data, works offline.
PROVIDER=open

# Public OpenStreetMap services ask for an identifying User-Agent. Add your email.
USER_AGENT=Breatheasy/0.1 (prototype; contact: you@example.com)

# Server-side key. In Google Cloud Console restrict it to:
#   API restrictions: Routes API, Air Quality API, Places API (New)
#   Application restrictions: IP addresses of your backend server
GOOGLE_MAPS_SERVER_KEY=
# If Google fails (quota, key, outage), serve open data instead
PROVIDER_FALLBACK=true
# Browser key: Maps JavaScript API only, restricted to your site's URL. Public by design.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAP_ID=

# Street-level context from OpenStreetMap (built by scripts/build_environment.py)
# Extra candidate routes through nearby parks and lakes
GREEN_DETOURS=3
# Conservative street-level adjustments to modelled pollution; 0 and 0 = model values only
STREET_ADJUST_BUSY_ROAD=0.15
STREET_ADJUST_GREEN=0.05

# Content-Security-Policy: report-only | enforce | off
CSP_MODE=report-only

# Frontend origin(s) allowed to call this API (JSON list)
CORS_ORIGINS=["http://localhost:5173"]

# Sampling / candidates
SAMPLE_SPACING_M=400
DETOUR_COUNT=2
MAX_CANDIDATES=6
ROUTE_CACHE_TTL_S=120

# Ranking
# "Cleanest air" (the default) ranks routes by average AQI and allows this much extra time
CLEANEST_AIR_DEFAULT_EXTRA_MINUTES=45
MEANINGFUL_AQI_POINTS=10
# Balanced / least-exposure modes
DEFAULT_MAX_EXTRA_MINUTES=10
MEANINGFUL_DIFF_PCT=10
BALANCED_PCT_PER_MIN=1.5

# Cost tracking: copy current per-1000-call prices (USD) from
# https://mapsplatform.google.com/pricing/ so each response reports cost per journey.
# Leave blank to report call counts only.
PRICE_ROUTES_PER_1000_USD=
PRICE_AQ_PER_1000_USD=
PRICE_PLACES_AUTOCOMPLETE_PER_1000_USD=
PRICE_PLACES_DETAILS_PER_1000_USD=

# Protect your billing account from runaway clients
ROUTE_REQUESTS_PER_MINUTE=20

# Research log: one JSON line per request, coordinates rounded to ~110 m
LOG_JOURNEYS=false
JOURNEY_LOG_PATH=data/journeys.jsonl
