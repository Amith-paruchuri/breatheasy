# Copy to frontend/.env.local
# Browser key for Maps JavaScript API ONLY. Restrict it in Google Cloud Console to:
#   API restrictions: Maps JavaScript API
#   Application restrictions: HTTP referrers (http://localhost:5173/*, https://your-domain/*)
# Leave empty to use the schematic preview (fine for PROVIDER=mock).
VITE_GOOGLE_MAPS_BROWSER_KEY=
# Optional vector Map ID from Cloud Console (Map Management). Defaults to DEMO_MAP_ID.
VITE_GOOGLE_MAP_ID=
# Backend URL when not using the dev proxy (e.g. https://api.your-domain.in)
VITE_API_BASE=
